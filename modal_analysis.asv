%% modal analysis
%define system parameters
LW = 10; LH = 1; LG = 3;
m = 1; Ic = (1/12)*(LH^2+LW^2);
g = 1; k = 20; k_list = [.5*k,.5*k,2*k,5*k];
l0 = 1.5*LG;
Pbl_box = [-LW;-LH]/2;
Pbr_box = [LW;-LH]/2;
Ptl_box = [-LW;LH]/2;
Ptr_box = [LW;LH]/2;
boundary_pts = [Pbl_box,Pbr_box,Ptr_box,Ptl_box,Pbl_box];
Pbl1_world = Pbl_box + [-LG;-LG];
Pbl2_world = Pbl_box + [LG;-LG];
Pbr1_world = Pbr_box + [0;-l0];
Pbr2_world = Pbr_box + [l0;0];
P_world = [Pbl1_world,Pbl2_world,Pbr1_world,Pbr2_world];
P_box = [Pbl_box,Pbl_box,Pbr_box,Pbr_box];
%define system parameters
box_params = struct();
box_params.m = m;
box_params.I = Ic;
box_params.g = g;
box_params.k_list = k_list;
box_params.l0_list = l0*ones(size(P_world,2));
box_params.P_world = P_world;
box_params.P_box = P_box;
box_params.boundary_pts = boundary_pts;

dx0 = 2;
dy0 = 0;
dtheta0 = 0;
vx0 = 0;
vy0 = 0;
vtheta0 = 0;

t_end = 1;

my_rate_func = @(t_in, V_in) box_rate_func(t_in,V_in,box_params);
t_in = 0;
root_rate_func = @(V_in) my_rate_func(t_in, V_in);

V0 = [dx0;dy0;dtheta0;vx0;vy0;vtheta0];
Veq = find_equilibrium(root_rate_func, V0);

J_approx = j_approx(root_rate_func, Veq);

Q = J_approx(4:6,1:3);
[vec, val] = eig(-Q);

w1 = sqrt(val(1,1));
w2 = sqrt(val(2,2));
w3 = sqrt(val(3,3));

b1 = vec(:,1);
b2 = vec(:,2);
b3 = vec(:,3);

U_mode = b3;
omega_n = w3;

epsilon = 0.1;

V0 = Veq + epsilon*[U_mode;0;0;0];

t_list = linspace(0, t_end, 100);

x_modal = Veq(1) + epsilon*U_mode(1)*cos(omega_n*t_list);
y_modal = Veq(2) + epsilon*U_mode(2)*cos(omega_n*t_list);
theta_modal = Veq(3) + epsilon*U_mode(3)*cos(omega_n*t_list);

tspan = [0 t_end];
%run the integration of nonlinear system
[tlist_nonlinear,Vlist_nonlinear] = ode45(my_rate_func, tspan, V0);



f=figure();
tcl = tiledlayout(3, 1);

nexttile(tcl);
hold on

plot(t_list, x_modal, 'k', LineWidth=5);
plot(tlist_nonlinear, Vlist_nonlinear(:,1), 'r--', LineWidth=5);
xlabel("Time (-)", Interpreter="latex", FontSize=14)
ylabel("x position (-)", Interpreter="latex", FontSize=14)
axis([0 1 0 0.04])
hold off;

nexttile(tcl);
hold on
plot(t_list, y_modal, 'k', LineWidth=5);
plot(tlist_nonlinear, Vlist_nonlinear(:,2), 'r--', LineWidth=5);
xlabel("Time (-)", Interpreter="latex", FontSize=14)
ylabel("y position (-)", Interpreter="latex", FontSize=14)
axis([0 1 0 0.03])
hold off;

nexttile(tcl);
hold on
plot(t_list, theta_modal, 'k', LineWidth=5);
plot(tlist_nonlinear, Vlist_nonlinear(:,3), 'r--', LineWidth=5);
xlabel("Time (-)", Interpreter="latex", FontSize=14)
ylabel("theta position (-)", Interpreter="latex", FontSize=14)
hold off;

sgtitle("Free Vibration Modal Analysis: Mode 3 ($\epsilon$ = 0.1)", Interpreter='latex', FontSize=15)
hl = legend(["Predicted Vibration" "Simulated Nonlinear Vibration"],Interpreter='latex', FontSize=15);
hl.Layout.Tile = 'South';

exportgraphics(f, 'plots/modal_mode_3.png', 'Resolution',300)


%% animation


num_zigs = 5;
w = .1;
hold on

path = 'C:\Users\fhalaska\Documents\MechEMath\mechemath-module5\plots\';
fname = 'mode_1_ani.avi';
input = [path, fname];

writerObj = VideoWriter(input);
open(writerObj);

fig1 = figure(1);
set(fig1,'units', 'pixels', 'position', [0 0 1440 1080]);
box_plot = plot(0,0,'k','LineWidth',2);

spring_plots = {};

num_springs = size(P_world,2);

for n=1:num_springs
    spring_plots{n} = initialize_spring_plot(num_zigs, w);
end


axis equal; axis square;

axis([-10,10,-10,10]);
ax = gca;
ax.FontSize = 16;
ax.XAxis.TickLabelInterpreter = 'Latex';
ax.YAxis.TickLabelInterpreter = 'Latex';

xlabel("x (-)", Interpreter="latex", FontSize=16)
ylabel("y (-)", Interpreter="latex", FontSize=16)
title("Mode 1 Free Vibrations", Interpreter="latex", FontSize=18)



for i = 1:size(Vlist_nonlinear, 1)
    p_list_world = compute_rbt(Vlist_nonlinear(i,1), Vlist_nonlinear(i,2), Vlist_nonlinear(i,3), box_params.P_box);

    boundary_points_world = compute_rbt(Vlist_nonlinear(i,1), Vlist_nonlinear(i,2), Vlist_nonlinear(i,3), boundary_pts);

    set(box_plot,'xdata',boundary_points_world(1,:),'ydata',boundary_points_world(2,:));
    update_all_springs(spring_plots,p_list_world,box_params);
    drawnow;
    current_frame = getframe(fig1);
    writeVideo(writerObj, current_frame);
    pause(.0001);
end
close(writerObj);




